{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asnk-scouts-nord-kivu",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "ASNK_MEDIA",
      "bucket_name": "asnk-media"
    }
  ]
}
